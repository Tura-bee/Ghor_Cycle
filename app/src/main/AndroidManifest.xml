<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions for Firebase & Connectivity Observer -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        tools:targetApi="31">

        <!-- Launcher Splash Activity -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication Activities -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:parentActivityName=".LoginActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Application Hub -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Item Management & Discovery -->
        <activity
            android:name=".AddItemActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ProductDetailsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Networking, REST & XML Hub (Stage 7) -->
        <activity
            android:name=".EcoInsightActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Recycling Directory & Eco-Impact Hub (Stage 8) -->
        <activity
            android:name=".RecyclingDirectoryActivity"
            android:exported="false"
            android:parentActivityName=".ProfileActivity" />

        <activity
            android:name=".EcoImpactActivity"
            android:exported="false"
            android:parentActivityName=".ProfileActivity" />

    </application>

</manifest>