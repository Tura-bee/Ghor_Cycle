<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/layoutSplashContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/layoutSplashActions"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_ghorcycle_logo"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/app_tagline"
            android:textColor="#E0F2FE"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvSplashQuote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontStyle="italic"
            android:gravity="center"
            android:text="@string/splash_quote"
            android:textColor="#99F6E4"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/pbSplashLoading"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:indeterminateTint="@color/white" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutSplashActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutSplashContent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSplashGetStarted"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/white"
            android:fontFamily="sans-serif-medium"
            android:text="@string/btn_get_started"
            android:textAllCaps="false"
            android:textColor="@color/brand_primary_dark"
            android:textSize="16sp"
            app:cornerRadius="12dp" />

        <TextView
            android:id="@+id/tvSplashAutoNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Navigating automatically in 2s..."
            android:textColor="#CCFBF1"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
