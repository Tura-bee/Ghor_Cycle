<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with Eco-Friendly Green & White styling -->
    <style name="Base.Theme.GhorCycle" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/eco_green_primary</item>
        <item name="colorPrimaryVariant">@color/eco_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/eco_green_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/eco_green_dark</item>
        <item name="android:windowBackground">@color/bg_light</item>
    </style>

    <style name="Theme.GhorCycle" parent="Base.Theme.GhorCycle" />
    <style name="Theme.MyApplication" parent="Theme.GhorCycle" />
</resources>
