rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: products
    // Document ID: {productId}
    // Fields:
    //   - productId: string (required, immutable) - Unique product listing identifier matching document ID
    //   - ownerId: string (required, immutable) - Firebase Auth UID of listing owner
    //   - title: string (required, 2-120 chars) - Title of the product
    //   - description: string (required, 3-2000 chars) - Detailed description
    //   - category: string (required, enum) - One of: 'Furniture', 'Clothes', 'Books', 'Kitchen Items', 'Electronics', 'Plastic', 'Paper', 'Metal'
    //   - condition: string (required, 1-100 chars) - Item condition (e.g., 'Like New', 'Used', 'Refurbished')
    //   - transactionType: string (required, enum) - One of: 'Sell', 'Free', 'Donate', 'Recycle'
    //   - price: number (required, >= 0) - Item price in currency units
    //   - location: string (required, 2-200 chars) - Community / pickup location
    //   - status: string (required, enum) - One of: 'Available', 'Reserved', 'Completed', 'Sold', 'Cycled'
    //   - createdAt: timestamp (required, immutable) - Timestamp when listing was created
    //   - updatedAt: timestamp (required) - Timestamp when listing was last updated
    //   - imageUrl: string (optional, 1-2000 chars) - Optional image URL or storage reference
    //
    // Subcollection: users/{userId}/favorites/{productId}
    // Document ID: {productId}
    // Fields:
    //   - productId: string (required, immutable) - Product ID saved
    //   - savedAt: timestamp (required) - Timestamp when saved
    //
    // Collection: item_requests
    // Document ID: {requestId}
    // Fields:
    //   - requestId: string (required, immutable) - Unique request ID matching document ID
    //   - productId: string (required, immutable) - Target product ID
    //   - productTitle: string (required, 2-120 chars) - Title of product
    //   - ownerId: string (required, immutable) - UID of listing owner
    //   - requesterId: string (required, immutable) - UID of requester
    //   - requesterEmail: string (optional, 3-200 chars) - Email of requester
    //   - requestType: string (required, enum: 'DONATION', 'EXCHANGE')
    //   - offeredItem: string (optional, 0-500 chars) - Offered item for exchange
    //   - message: string (required, 1-1000 chars) - Message to owner
    //   - status: string (required, enum: 'PENDING', 'ACCEPTED', 'REJECTED', 'CANCELLED')
    //   - createdAt: timestamp (required, immutable)
    //   - updatedAt: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidProduct(data) {
      let allowedFields = [
        'productId', 'ownerId', 'title', 'description',
        'category', 'condition', 'transactionType', 'price',
        'location', 'status', 'createdAt', 'updatedAt', 'imageUrl'
      ];
      let requiredFields = [
        'productId', 'ownerId', 'title', 'description',
        'category', 'condition', 'transactionType', 'price',
        'location', 'status', 'createdAt', 'updatedAt'
      ];
      let validCategories = [
        'Furniture', 'Clothes', 'Books', 'Kitchen Items',
        'Electronics', 'Plastic', 'Paper', 'Metal'
      ];
      let validStatuses = [
        'Available', 'Reserved', 'Completed', 'Sold', 'Cycled'
      ];
      let validTransactionTypes = [
        'Sell', 'Free', 'Donate', 'Recycle'
      ];

      return hasOnlyAllowedFields(allowedFields) &&
        hasRequiredFields(requiredFields) &&
        data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128 &&
        data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
        validStringLength('title', 2, 120) &&
        validStringLength('description', 3, 2000) &&
        data.category in validCategories &&
        validStringLength('condition', 1, 100) &&
        data.transactionType in validTransactionTypes &&
        data.price is number && data.price >= 0 &&
        validStringLength('location', 2, 200) &&
        data.status in validStatuses &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        isValidOptionalString('imageUrl', 1, 2000);
    }

    function isValidFavorite(data, productId) {
      let allowedFields = ['productId', 'savedAt'];
      return hasOnlyAllowedFields(allowedFields) &&
        hasRequiredFields(allowedFields) &&
        data.productId == productId &&
        data.savedAt is timestamp;
    }

    function isValidRequest(data) {
      let allowedFields = [
        'requestId', 'productId', 'productTitle', 'ownerId',
        'requesterId', 'requesterEmail', 'requestType', 'offeredItem',
        'message', 'status', 'createdAt', 'updatedAt'
      ];
      let requiredFields = [
        'requestId', 'productId', 'productTitle', 'ownerId',
        'requesterId', 'requestType', 'message', 'status',
        'createdAt', 'updatedAt'
      ];
      let validRequestTypes = ['DONATION', 'EXCHANGE'];
      let validStatuses = ['PENDING', 'ACCEPTED', 'REJECTED', 'CANCELLED'];

      return hasOnlyAllowedFields(allowedFields) &&
        hasRequiredFields(requiredFields) &&
        data.requestId is string && data.requestId.size() > 0 && data.requestId.size() <= 128 &&
        data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128 &&
        validStringLength('productTitle', 2, 120) &&
        data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
        data.requesterId is string && data.requesterId.size() > 0 && data.requesterId.size() <= 128 &&
        isValidOptionalString('requesterEmail', 3, 200) &&
        data.requestType in validRequestTypes &&
        isValidOptionalString('offeredItem', 0, 500) &&
        validStringLength('message', 1, 1000) &&
        data.status in validStatuses &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // ===============================================================
    // Security Rules
    // ===============================================================

    // Root collection: products
    match /products/{productId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.productId == productId &&
        isValidProduct(request.resource.data);

      allow update: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.productId == resource.data.productId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isValidProduct(request.resource.data);

      allow delete: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;
    }

    // Subcollection: users/{userId}/favorites/{productId}
    match /users/{userId}/favorites/{productId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Collection: item_requests
    match /item_requests/{requestId} {
      // Both the requester and the product owner can read the request
      allow read: if isAuthenticated() &&
        (resource.data.requesterId == request.auth.uid || resource.data.ownerId == request.auth.uid);

      // Authenticated users can create requests, but cannot request their own products
      allow create: if isAuthenticated() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.requesterId != request.resource.data.ownerId &&
        request.resource.data.requestId == requestId &&
        request.resource.data.status == 'PENDING' &&
        isValidRequest(request.resource.data);

      // Owner can ACCEPT or REJECT; Requester can CANCEL; Immutable core keys
      allow update: if isAuthenticated() &&
        (resource.data.ownerId == request.auth.uid || resource.data.requesterId == request.auth.uid) &&
        request.resource.data.requestId == resource.data.requestId &&
        request.resource.data.productId == resource.data.productId &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.requesterId == resource.data.requesterId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (
          (resource.data.ownerId == request.auth.uid && request.resource.data.status in ['ACCEPTED', 'REJECTED', 'PENDING']) ||
          (resource.data.requesterId == request.auth.uid && request.resource.data.status in ['CANCELLED', 'PENDING'])
        ) &&
        isValidRequest(request.resource.data);

      // Listing owner or requester can delete the request
      allow delete: if isAuthenticated() &&
        (resource.data.ownerId == request.auth.uid || resource.data.requesterId == request.auth.uid);
    }

    // Default deny for all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
